---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <section class="hero">
    <div>
      <h1>{site.pitch}</h1>
      <p>{site.name}, {site.role}. {site.status}.</p>
      <div class="cta">
        <a class="btn fill" href="/#projects">See the games</a>
        {site.links.map(l => <a class="btn" href={l.url} rel="noopener">{l.label}</a>)}
        {site.resume && <a class="btn" href={site.resume}>Resume</a>}
        <a class="btn" href={`mailto:${site.email}`}>Email me</a>
      </div>
    </div>
    
  </section>
  <section class="block" id="projects">
    <h2>Projects</h2>
    <div class="grid">{projects.map(p => <ProjectCard id={p.id} data={p.data} />)}</div>
  </section>
  <section class="block">
    <h2>Skills</h2>
    <div class="skills">{site.skills.map(s => <div><h3>{s.group}</h3><ul>{s.items.map(i => <li>{i}</li>)}</ul></div>)}</div>
  </section>
</Base>
